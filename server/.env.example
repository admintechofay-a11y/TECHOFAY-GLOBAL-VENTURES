# ==========================================
# TECHOFAY GLOBAL VENTURES - Backend Environment
# ==========================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas Free Tier (M0 forever free cluster):
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/techofay_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/techofay_db

# Security & Master Auth
JWT_SECRET=super_secure_random_jwt_secret_key_techofay_2025
ADMIN_EMAIL=admin@techofay.com
ADMIN_PASSWORD=Techofay@2025!

# Free Transactional Email Dispatch (Resend, Brevo, or Ethereal Test Mailer):
# If omitted or left empty, the server automatically boots an Ethereal test mailer for zero setup.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@techofay.com
