PORT=5000
NODE_ENV=development

# MongoDB — get from MongoDB Atlas (free tier)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/techofay_db

# Generate with: node -e "require('crypto').randomBytes(64).then(b => console.log(b.toString('hex')))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# Admin — set your own credentials, never commit real values
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_SECURE_PASSWORD

# SMTP — use Gmail App Password or Brevo/Resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_NOT_GMAIL_PASSWORD
SMTP_FROM=no-reply@techofay.com

# Frontend URL for CORS
FRONTEND_URL=https://techofay.com
